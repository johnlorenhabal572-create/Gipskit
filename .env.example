# ==============================================================================
# Environment Configuration & Secrets Template
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce_db?retryWrites=true&w=majority)
# If left blank or unreachable, the application automatically uses high-performance in-memory fallback storage.
MONGODB_URI=

# ------------------------------------------------------------------------------
# SMTP Email Transporter (Real Gmail / Email OTP 6-Digit Codes)
# ------------------------------------------------------------------------------
# To enable real email dispatch for Gmail verification codes (works on Render & Cloud Run):
# Host (defaults to smtp.gmail.com)
SMTP_HOST=smtp.gmail.com
# Port (465 for SSL - recommended for Render/Cloud hosting, 587 for STARTTLS)
SMTP_PORT=465
# SMTP username (e.g., your-store-email@gmail.com)
SMTP_USER=
# SMTP App Password (e.g., 16-character Google App Password)
SMTP_PASS=
# Sender header (optional, e.g., "Gip's Kitchen" <your-store-email@gmail.com>)
SMTP_FROM=

# ------------------------------------------------------------------------------
# Default Store Administrator Account
# ------------------------------------------------------------------------------
# Default admin credentials seeded automatically on startup.
# Note: Password must be 8 characters long, containing at least 1 uppercase letter and 1 number.
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin123
