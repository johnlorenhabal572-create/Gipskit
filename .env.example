# ==============================================================================
# Environment Configuration & Secrets Template
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce_db?retryWrites=true&w=majority)
# If left blank or unreachable, the application automatically uses high-performance in-memory fallback storage.
MONGODB_URI=

# ------------------------------------------------------------------------------
# Email Transporter (Real Gmail / SMTP OTP 6-Digit Codes)
# ------------------------------------------------------------------------------
# Option A: Simple Gmail Setup (Recommended)
GMAIL_USER=your-restaurant@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option B: Standard SMTP Setup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-restaurant@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Gip's Kitchen" <your-restaurant@gmail.com>

# ------------------------------------------------------------------------------
# Default Store Administrator Account
# ------------------------------------------------------------------------------
# Default admin credentials seeded automatically on startup.
# Note: Password must be 8 characters long, containing at least 1 uppercase letter and 1 number.
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin123
